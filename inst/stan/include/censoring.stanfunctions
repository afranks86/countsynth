// Censored small-count helper. Source data suppresses counts 1-9; a
// suppressed cell contributes log P(Y in {1..9}) and an observed cell
// contributes log P(Y not in {1..9}) (via log1m_exp at the call site).
// Mirrors likelihood.py's logsumexp over the pmf at values 1..9.

// log P(Y in {1..9}) for Poisson (is_nb=0) or NB2 (is_nb=1) at log-mean lm.
real suppressed_mass(real lm, real phi, int is_nb) {
  vector[9] lp;
  for (v in 1:9) {
    lp[v] = is_nb == 1 ? neg_binomial_2_log_lpmf(v | lm, phi)
                       : poisson_log_lpmf(v | lm);
  }
  return log_sum_exp(lp);
}
