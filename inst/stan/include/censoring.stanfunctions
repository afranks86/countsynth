// Censored small-count helpers. Source data suppresses counts in a range
// (supp_lo..supp_hi, by default 1-9), and a suppressed cell contributes
// log P(Y in that range). Mirrors likelihood.py's logsumexp over the pmf at
// values 1..9. A cell pooling a suppressed count with others has a range of
// its own, and the same helpers take that cell's support.
//
// Instead of one *_lpmf call per support point per cell per gradient
// evaluation, the pmf is factored so that everything depending only on the
// concentration is precomputed once per unit (coefficient row b), leaving
// one cheap log_sum_exp over the support per cell:
//   NB2(v | mu, phi), eta = log(mu), d = log(1 + mu / phi):
//     lp(v) = b[v] - phi * d + v * (eta - log(phi) - d)
//     b[v]  = lgamma(v + phi) - lgamma(phi) - lgamma(v + 1)
//   Poisson(v | mu): lp(v) = -mu + v * eta - lgamma(v + 1)
//
// Both NB terms are written the way Stan's own neg_binomial_2 computes them,
// because the textbook forms fall apart as phi grows -- which a sampled
// dispersion near zero (phi = 1 / disp) asks for. The lgamma difference in b
// subtracts two numbers near 3e16 at phi = 1e15, and phi * (log(phi) - L)
// multiplies a difference of two numbers near log(phi) by phi. Past phi ~1e10
// both are noise: neighbouring phi then gave log-masses scattered over
// several nats, positive ones included, and a chain that wandered there
// froze, every proposal rejected and its step size adapted to ~1e-13.

// Per-unit NB coefficient row over a support (1..9 by default).
vector nb_censor_coeff(real phi, vector sup) {
  int n = rows(sup);
  vector[n] b;
  for (i in 1 : n) {
    b[i] = lchoose(sup[i] + phi - 1, sup[i]);
  }
  return b;
}

// log P(Y in support) for NB2 at log-mean eta, concentration phi.
real suppressed_mass_nb(real eta, real phi, real log_phi, vector b,
                        vector sup) {
  real d = log1p_exp(eta - log_phi);
  return -phi * d + log_sum_exp(b + sup * (eta - log_phi - d));
}

// log P(Y in support) for Poisson at log-mean eta.
real suppressed_mass_pois(real eta, vector neg_lgamma_sup1, vector sup) {
  return -exp(eta) + log_sum_exp(neg_lgamma_sup1 + sup * eta);
}
